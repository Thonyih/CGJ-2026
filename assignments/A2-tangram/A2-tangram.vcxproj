<?xml version="1.0" encoding="utf-8"?>
<!--
  Assignment A2 - 2D Tangram (Shark)
  Visual Studio project. Open A2-tangram.sln and press F5.

  The libraries are in libraries\ (as in the lab setup guide) and are
  compiled from source together with the program, so nothing has to be
  installed and no DLLs have to be copied:
    libraries\glew  GLEW 2.2.0  (glew.c, linked statically: GLEW_STATIC)
    libraries\glfw  GLFW 3.4    (the Windows source files)
    libraries\glm   GLM 1.0.1   (headers only)
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{9D887C71-C957-491D-B9E0-5199052A9A03}</ProjectGuid>
    <RootNamespace>A2tangram</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!-- $(DefaultPlatformToolset): use the compiler of whichever Visual Studio
       opens the project (VS 2022 or VS 2026), so no retargeting is needed. -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <!-- All build output goes into build\ (easy to delete before zipping).
       The program runs from src\, where the shader files are. -->
  <PropertyGroup>
    <OutDir>$(SolutionDir)build\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(Configuration)\</IntDir>
    <LocalDebuggerWorkingDirectory>$(ProjectDir)src\</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>

  <!-- Settings shared by Debug and Release -->
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(SolutionDir)libraries\glew\include;$(SolutionDir)libraries\glfw\include;$(SolutionDir)libraries\glm;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- GLEW_STATIC: GLEW is compiled into the program (no glew32.dll).
           _GLFW_WIN32, UNICODE, _CRT_SECURE_NO_WARNINGS: needed to compile GLFW on Windows. -->
      <PreprocessorDefinitions>GLEW_STATIC;_GLFW_WIN32;UNICODE;_UNICODE;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>opengl32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <!-- Also copy the shaders next to the .exe, so it can be run by double-clicking it. -->
    <PostBuildEvent>
      <Command>xcopy /y /d "$(ProjectDir)src\*.glsl" "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <!-- DEBUG: the teacher's mgl code uses "#ifdef DEBUG" to turn on the OpenGL debug output. -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <PreprocessorDefinitions>DEBUG;_DEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <!-- The program -->
  <ItemGroup>
    <ClCompile Include="src\tangram.cpp" />
    <ClCompile Include="mgl\mglApp.cpp" />
    <ClCompile Include="mgl\mglError.cpp" />
    <ClCompile Include="mgl\mglShader.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="mgl\mgl.hpp" />
    <ClInclude Include="mgl\mglApp.hpp" />
    <ClInclude Include="mgl\mglConventions.hpp" />
    <ClInclude Include="mgl\mglError.hpp" />
    <ClInclude Include="mgl\mglGL.hpp" />
    <ClInclude Include="mgl\mglShader.hpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="src\tangram-vs.glsl" />
    <None Include="src\tangram-fs.glsl" />
    <None Include="README.md" />
  </ItemGroup>

  <!-- Libraries, compiled from source (warnings from library code are hidden) -->
  <ItemGroup>
    <ClCompile Include="libraries\glew\src\glew.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\context.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\init.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\input.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\monitor.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\platform.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\vulkan.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\window.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\egl_context.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\osmesa_context.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\null_init.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\null_monitor.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\null_window.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\null_joystick.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\win32_module.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\win32_time.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\win32_thread.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\win32_init.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\win32_joystick.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\win32_monitor.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\win32_window.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
    <ClCompile Include="libraries\glfw\src\wgl_context.c"><WarningLevel>TurnOffAllWarnings</WarningLevel></ClCompile>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
